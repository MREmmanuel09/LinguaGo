# Editorial config LinguaGo — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_file = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{kt,kts}]
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_allow_trailing_comma = true
# ktlint no detecta de forma fiable la excepción PascalCase para funs
# @Composable (material3 existe nomenclatura Compose); lo desactivamos.
ktlint_standard_function-naming = disabled
# Constantes de identidad LinguaGo usan PascalCase estilo Compose (LinguaIcons).
ktlint_standard_property-naming = disabled

[*.{yml,yaml,json}]
indent_size = 2

[*.{xml,md}]
indent_size = 4
